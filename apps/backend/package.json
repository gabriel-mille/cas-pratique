{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "backend",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{workspaceRoot}/apps/backend/dist"
        ],
        "options": {
          "outputPath": "apps/backend/dist",
          "main": "apps/backend/src/main.ts",
          "tsConfig": "apps/backend/tsconfig.app.json",
          "assets": [
            "apps/backend/src/assets",
            {
              "input": "apps/backend/src/modules/identity/infrastructure",
              "glob": "common-passwords.txt",
              "output": "src/modules/identity/infrastructure"
            }
          ]
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/backend/dist/package.json",
          "{workspaceRoot}/apps/backend/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/backend/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "backend:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "backend:build:development"
          },
          "production": {
            "buildTarget": "backend:build:production"
          }
        }
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --config apps/backend/vitest.integration.config.mts"
        }
      },
      "migration-generate": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "typeorm migration:generate --pretty -d apps/backend/dist/src/database/data-source.js apps/backend/src/database/migrations/{args.name}"
        }
      },
      "migration-run": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "typeorm migration:run -d apps/backend/dist/src/database/data-source.js"
        }
      },
      "migration-revert": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "typeorm migration:revert -d apps/backend/dist/src/database/data-source.js"
        }
      },
      "openapi": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node apps/backend/dist/src/generate-openapi.js apps/frontend/src/shared/api/openapi.json"
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  }
}
