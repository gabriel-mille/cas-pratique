  "info": {
    "title": "Qualineo – Plans d’actions",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "organizationName": {
            "type": "string",
            "maxLength": 200,
            "example": "Clinique des Lilas"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "example": "Alice Martin"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "example": "alice@lilas.fr"
          },
          "password": {
            "type": "string",
            "minLength": 15,
            "maxLength": 128
          }
        },
        "required": [
          "organizationName",
          "name",
          "email",
          "password"
        ]
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "mustChangePassword": {
            "type": "boolean",
            "description": "Vrai avec un mot de passe temporaire : seul son changement est permis (D8)"
          }
        },
        "required": [
          "mustChangePassword"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "alice@lilas.fr"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 15,
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "CurrentMemberResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "MEMBER",
              "MANAGER",
              "ADMIN"
            ]
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "organizationName": {
            "type": "string"
          },
          "mustChangePassword": {
            "type": "boolean"
          }
        },
        "required": [
          "userId",
          "name",
          "email",
          "role",
          "organizationId",
          "organizationName",
          "mustChangePassword"
        ]
      },
      "MemberResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "MEMBER",
              "MANAGER",
              "ADMIN"
            ]
          }
        },
        "required": [
          "userId",
          "name",
          "email",
          "role"
        ]
      },
      "AddMemberRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "role": {
            "type": "string",
            "enum": [
              "MEMBER",
              "MANAGER",
              "ADMIN"
            ]
          }
        },
        "required": [
          "email",
          "name",
          "role"
        ]
      },
      "AddedMemberResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "temporaryPassword": {
            "type": "string",
            "description": "Affiché une seule fois, à transmettre au membre (D8)"
          }
        },
        "required": [
          "userId",
          "temporaryPassword"
        ]
      },
      "ChangeRoleRequest": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "MEMBER",
              "MANAGER",
              "ADMIN"
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "ActionPlanResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "version": {
            "type": "number",
            "description": "Aussi rendue dans l’en-tête ETag, à renvoyer en If-Match (D14)"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "version"
        ]
      },
      "TitledRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "nullable": true
          }
        },
        "required": [
          "title"
        ]
      },
      "ActionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "version": {
            "type": "number",
            "description": "Aussi rendue dans l’en-tête ETag, à renvoyer en If-Match (D14)"
          },
          "planId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "TODO",
              "IN_PROGRESS",
              "TO_VALIDATE",
              "DONE"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "version",
          "planId",
          "status"
        ]
      },
      "AuthorResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "userId",
          "name"
        ]
      },
      "StatusChangeResponse": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "enum": [
              "TODO",
              "IN_PROGRESS",
              "TO_VALIDATE",
              "DONE"
            ]
          },
          "to": {
            "type": "string",
            "enum": [
              "TODO",
              "IN_PROGRESS",
              "TO_VALIDATE",
              "DONE"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "author": {
            "$ref": "#/components/schemas/AuthorResponse"
          }
        },
        "required": [
          "from",
          "to",
          "at",
          "reason",
          "author"
        ]
      },
      "ActionDetailResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "version": {
            "type": "number",
            "description": "Aussi rendue dans l’en-tête ETag, à renvoyer en If-Match (D14)"
          },
          "planId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "TODO",
              "IN_PROGRESS",
              "TO_VALIDATE",
              "DONE"
            ]
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatusChangeResponse"
            }
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "version",
          "planId",
          "status",
          "history"
        ]
      },
      "ChangeStatusRequest": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "enum": [
              "TODO",
              "IN_PROGRESS",
              "TO_VALIDATE",
              "DONE"
            ]
          }
        },
        "required": [
          "to"
        ]
      },
      "RejectionRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "reason"
        ]
      }
    }
  }
}
